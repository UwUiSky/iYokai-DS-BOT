# Servizio di sistema della sandbox delle immagini (D62, modo A) e delle conversioni di allegati (D74: PDF, audio, video, testo).
# Servono `ffmpeg` e `ffprobe` di sistema (pacchetto `ffmpeg`) e gli stessi pacchetti Python del bot (pypdf, pillow-heif).
# Esempio: adatta i percorsi, poi vedi docs/immagini-sandbox.md per l'installazione.
[Unit]
Description=iYokai sandbox delle immagini
After=local-fs.target

[Service]
Type=simple
# Utente di sistema senza shell e senza permessi (lo crea lo script nei passi di docs/immagini-sandbox.md).
User=iyokai-sbx
Group=iyokai-sbx
# Lo stesso interprete del bot (quello con Pillow e zxing-cpp): senza, il filtro dice «sandbox non disponibile».
ExecStart=/opt/iyokai/.venv/bin/python3 -I /opt/iyokai/core/immagini_servizio.py
Environment=IYOKAI_QUARANTENA_DIR=/var/lib/iyokai/quarantena
Environment=IYOKAI_SANDBOX_SOCKET=/run/iyokai-sbx/sock
# Socket: cartella creata dal servizio, gruppo iyokai-sbx. Il bot (utente iyokai) e' membro di iyokai-sbx;
# il servizio NON riceve il gruppo del bot: un worker compromesso non deve leggere i file del bot.
RuntimeDirectory=iyokai-sbx
RuntimeDirectoryMode=0750
UMask=0007
Restart=on-failure
RestartSec=3

# Niente rete: solo socket Unix.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
# Sola lettura su tutto, e sulla quarantena in particolare.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/var/lib/iyokai/quarantena /opt/iyokai
# I segreti del bot non si vedono proprio (il trattino: niente errore se il file non c'e').
InaccessiblePaths=-/opt/iyokai/.env -/opt/iyokai/logs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Un processo figlio per lavoro: tetti dell'insieme (il figlio ha anche i suoi: immagini 512 MiB e 4 s di CPU;
# conversioni D74 fino a 1,5 GiB di spazio virtuale per il video). ffmpeg gira come figlio del figlio, con pochi thread.
# Scrive solo nella cartella temporanea privata del lavoro (PrivateTmp), con tetto di 12 MiB per file.
MemoryMax=1536M
MemorySwapMax=0
CPUQuota=100%
TasksMax=32
LimitCORE=0

[Install]
WantedBy=multi-user.target
