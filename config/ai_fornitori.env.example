# config/ai_fornitori.env.example (D54, D55)
# Servizi AI gratuiti già compilati. Copia questo file in config/ai_fornitori.env
# (accanto al .env, mai nel repository) e incolla SOLO le chiavi dopo «AI_KEY_<SERVIZIO>=».
# Un servizio senza chiave viene saltato in silenzio. Un modello può avere la chiave propria
# (AI_KEY_GEMINI_LITE) oppure usare quella del servizio (AI_KEY_GEMINI).
# Controllo dei dati: 01/11/2026. I limiti cambiano spesso: la sentinella li ricontrolla ogni settimana.
# AI_ADDESTRA=si: il servizio nel livello gratuito può addestrare sui dati; il bot lo usa solo come
# ripiego e mai sui server con privacy «senza_messaggi» (D19, D55). Dubbio = «si».
# Per spegnere tutti quelli che addestrano: AI_AMMETTI_ADDESTRANO=no nel .env.
# Tipi non compilati qui (audio, confronto/embedding): il bot non ha ancora il trasporto, vedi docs/servizi_ai.md.
# Se nel .env AI_FORNITORI è vuoto vale l'elenco qui sotto; per accendere un servizio spento aggiungi
# i suoi nomi all'elenco.

AI_FORNITORI=gemini_lite,gemini_flash,groq_oss120,groq_oss20,groq_qwen,mistral_small,mistral_codestral,openrouter_gemma,cloudflare_llama,nvidia_nemotron,ovh_qwen,pollinations_img
AI_AMMETTI_ADDESTRANO=si

# ======================================================================
# Google AI Studio (Gemini)  [ACCESO di default]
# Limiti: Limiti per progetto, visibili in AI Studio; valori sotto prudenti. Testo: gemini-3.1-flash-lite e gemini-3.8-flash gratuiti; immagini non gratuite.
# Carta: no · Italia: si · Addestra: si · Fonte: https://ai.google.dev/gemini-api/docs/pricing
# Termini/privacy: https://ai.google.dev/gemini-api/terms
# Nota: Nei termini il livello gratuito migliora i prodotti Google; per SEE/UK/Svizzera valgono i termini a pagamento (nessun addestramento). Se il bot gira nel SEE si può mettere AI_ADDESTRA a no, a tua scelta. Audio gratis: gemini-3.5-transcribe (serve trasporto audio, non ancora nel bot).
# ----------------------------------------------------------------------
AI_KEY_GEMINI=
AI_URL_GEMINI_LITE=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODELLO_GEMINI_LITE=gemini-3.1-flash-lite
AI_TIPI_GEMINI_LITE=chat,testo,giudizio,traduzione
AI_FASCIA_GEMINI_LITE=bassa
AI_LIMITI_GEMINI_LITE=rpm=10,rpg=250,tpm=250000
AI_ADDESTRA_GEMINI_LITE=si
AI_PAGAMENTO_GEMINI_LITE=no
AI_COSTO_GEMINI_LITE=0
AI_URL_GEMINI_FLASH=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODELLO_GEMINI_FLASH=gemini-3.8-flash
AI_TIPI_GEMINI_FLASH=chat,testo,giudizio,traduzione,codice
AI_FASCIA_GEMINI_FLASH=alta
AI_LIMITI_GEMINI_FLASH=rpm=5,rpg=100,tpm=250000
AI_ADDESTRA_GEMINI_FLASH=si
AI_PAGAMENTO_GEMINI_FLASH=no
AI_COSTO_GEMINI_FLASH=0

# ======================================================================
# Groq  [ACCESO di default]
# Limiti: gpt-oss-120b, gpt-oss-20b, qwen/qwen3.8-27b: 30 rpm, 1000 al giorno, 8000 token/min, 200000 token/giorno. whisper-large-v3: 20 rpm, 2000 al giorno (trascrizione, serve trasporto audio).
# Carta: no · Italia: si · Addestra: no · Fonte: https://console.groq.com/docs/rate-limits
# Termini/privacy: https://console.groq.com/docs/your-data
# Nota: Non conserva i dati per impostazione predefinita (log fino a 30 giorni per abusi, disattivabili); la pagina non dice esplicitamente «non addestra». La pagina dei limiti non distingue piano gratuito e Developer: controlla in console.groq.com/settings/limits.
# ----------------------------------------------------------------------
AI_KEY_GROQ=
AI_URL_GROQ_OSS120=https://api.groq.com/openai/v1
AI_MODELLO_GROQ_OSS120=openai/gpt-oss-120b
AI_TIPI_GROQ_OSS120=chat,testo,giudizio,traduzione,codice
AI_FASCIA_GROQ_OSS120=alta
AI_LIMITI_GROQ_OSS120=rpm=30,rpg=1000,tpm=8000,tpg=200000
AI_ADDESTRA_GROQ_OSS120=no
AI_PAGAMENTO_GROQ_OSS120=no
AI_COSTO_GROQ_OSS120=0
AI_URL_GROQ_OSS20=https://api.groq.com/openai/v1
AI_MODELLO_GROQ_OSS20=openai/gpt-oss-20b
AI_TIPI_GROQ_OSS20=chat,testo,giudizio,traduzione
AI_FASCIA_GROQ_OSS20=bassa
AI_LIMITI_GROQ_OSS20=rpm=30,rpg=1000,tpm=8000,tpg=200000
AI_ADDESTRA_GROQ_OSS20=no
AI_PAGAMENTO_GROQ_OSS20=no
AI_COSTO_GROQ_OSS20=0
AI_URL_GROQ_QWEN=https://api.groq.com/openai/v1
AI_MODELLO_GROQ_QWEN=qwen/qwen3.8-27b
AI_TIPI_GROQ_QWEN=chat,testo,giudizio,traduzione,codice
AI_FASCIA_GROQ_QWEN=media
AI_LIMITI_GROQ_QWEN=rpm=30,rpg=1000,tpm=8000,tpg=200000
AI_ADDESTRA_GROQ_QWEN=no
AI_PAGAMENTO_GROQ_QWEN=no
AI_COSTO_GROQ_QWEN=0

# ======================================================================
# Mistral (La Plateforme, piano gratuito)  [ACCESO di default]
# Limiti: Circa 1 richiesta al secondo, 500000 token/min, circa 1 miliardo di token al mese (fonte secondaria); i valori veri sono in console.mistral.ai/limits.
# Carta: no (serve il telefono) · Italia: si · Addestra: si · Fonte: https://docs.mistral.ai/deployment/laplateforme/tier/
# Termini/privacy: https://help.mistral.ai/en/articles/347617-do-you-use-my-user-data-to-train-your-models
# Nota: Il piano gratuito può usare i dati per addestrare, con opt-out nelle impostazioni (Settings, Privacy): fatto l'opt-out si può mettere AI_ADDESTRA a no. Verifica del numero di telefono richiesta.
# ----------------------------------------------------------------------
AI_KEY_MISTRAL=
AI_URL_MISTRAL_SMALL=https://api.mistral.ai/v1
AI_MODELLO_MISTRAL_SMALL=mistral-small-latest
AI_TIPI_MISTRAL_SMALL=chat,testo,giudizio,traduzione
AI_FASCIA_MISTRAL_SMALL=media
AI_LIMITI_MISTRAL_SMALL=rpm=30,tpm=500000
AI_ADDESTRA_MISTRAL_SMALL=si
AI_PAGAMENTO_MISTRAL_SMALL=no
AI_COSTO_MISTRAL_SMALL=0
AI_URL_MISTRAL_CODESTRAL=https://api.mistral.ai/v1
AI_MODELLO_MISTRAL_CODESTRAL=codestral-latest
AI_TIPI_MISTRAL_CODESTRAL=codice
AI_FASCIA_MISTRAL_CODESTRAL=alta
AI_LIMITI_MISTRAL_CODESTRAL=rpm=30,tpm=500000
AI_ADDESTRA_MISTRAL_CODESTRAL=si
AI_PAGAMENTO_MISTRAL_CODESTRAL=no
AI_COSTO_MISTRAL_CODESTRAL=0

# ======================================================================
# OpenRouter (modelli :free)  [ACCESO di default]
# Limiti: Modelli con suffisso :free: 20 richieste al minuto, 50 al giorno (1000 dopo un acquisto una tantum di 10 crediti).
# Carta: no · Italia: si · Addestra: si · Fonte: https://openrouter.ai/docs/api-reference/limits
# Termini/privacy: https://openrouter.ai/docs/features/privacy-and-logging
# Nota: I fornitori dei modelli gratuiti possono addestrare; l'impostazione dell'account per escluderli esiste (separata per modelli gratuiti e a pagamento). I nomi dei modelli gratuiti cambiano spesso: /ai modello li cambia a caldo.
# ----------------------------------------------------------------------
AI_KEY_OPENROUTER=
AI_URL_OPENROUTER_GEMMA=https://openrouter.ai/api/v1
AI_MODELLO_OPENROUTER_GEMMA=google/gemma-4-31b-it:free
AI_TIPI_OPENROUTER_GEMMA=chat,testo,giudizio,traduzione
AI_FASCIA_OPENROUTER_GEMMA=bassa
AI_LIMITI_OPENROUTER_GEMMA=rpm=20,rpg=50
AI_ADDESTRA_OPENROUTER_GEMMA=si
AI_PAGAMENTO_OPENROUTER_GEMMA=no
AI_COSTO_OPENROUTER_GEMMA=0

# ======================================================================
# Cloudflare Workers AI  [ACCESO di default]
# Limiti: 10000 «neurons» al giorno (azzeramento 00:00 UTC), testo 300 richieste al minuto. Circa 200-400 richieste al giorno con un modello piccolo.
# Carta: no · Italia: si · Addestra: no · Fonte: https://developers.cloudflare.com/workers-ai/platform/pricing/
# Termini/privacy: https://developers.cloudflare.com/workers-ai/platform/data-usage/
# Nota: Sostituisci ACCOUNT_ID nell'indirizzo con l'ID del tuo account. «Cloudflare non usa i contenuti per addestrare». Immagini ed embedding non hanno il formato OpenAI qui: non usati.
# ----------------------------------------------------------------------
AI_KEY_CLOUDFLARE=
AI_URL_CLOUDFLARE_LLAMA=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
AI_MODELLO_CLOUDFLARE_LLAMA=@cf/meta/llama-3.1-8b-instruct
AI_TIPI_CLOUDFLARE_LLAMA=chat,testo,giudizio,traduzione
AI_FASCIA_CLOUDFLARE_LLAMA=bassa
AI_LIMITI_CLOUDFLARE_LLAMA=rpm=100,rpg=200
AI_ADDESTRA_CLOUDFLARE_LLAMA=no
AI_PAGAMENTO_CLOUDFLARE_LLAMA=no
AI_COSTO_CLOUDFLARE_LLAMA=0

# ======================================================================
# NVIDIA NIM (build.nvidia.com)  [ACCESO di default]
# Limiti: Circa 40 richieste al minuto in totale sulla chiave, nessun tetto giornaliero dichiarato; solo prototipi.
# Carta: no (serve il telefono) · Italia: si · Addestra: si · Fonte: https://freellm.net/providers/nvidia-nim
# Termini/privacy: https://www.nvidia.com/en-us/agreements/trial-service/api-trial-terms-of-service/
# Nota: Termini di prova non letti: per prudenza segnato «addestra». Il nome del modello va confermato nel catalogo; alcuni modelli danno 403 finché non si preme «Try API» sulla loro pagina.
# ----------------------------------------------------------------------
AI_KEY_NVIDIA=
AI_URL_NVIDIA_NEMOTRON=https://integrate.api.nvidia.com/v1
AI_MODELLO_NVIDIA_NEMOTRON=nvidia/nemotron-3-super-120b-a12b
AI_TIPI_NVIDIA_NEMOTRON=chat,testo,giudizio,traduzione,codice
AI_FASCIA_NVIDIA_NEMOTRON=media
AI_LIMITI_NVIDIA_NEMOTRON=rpm=40
AI_ADDESTRA_NVIDIA_NEMOTRON=si
AI_PAGAMENTO_NVIDIA_NEMOTRON=no
AI_COSTO_NVIDIA_NEMOTRON=0

# ======================================================================
# OVHcloud AI Endpoints (Francia)  [ACCESO di default]
# Limiti: Senza chiave circa 2 richieste al minuto; con un account gratuito e un token i limiti salgono (non pubblicati).
# Carta: no · Italia: si · Addestra: si · Fonte: https://freellm.net/providers/ovhcloud-ai-endpoints
# Termini/privacy: https://www.ovhcloud.com/en/public-cloud/ai-endpoints/
# Nota: Ospitato in Francia, in regola con il GDPR. Qui serve il token dell'account (il bot richiede una chiave). Politica di addestramento non letta: segnato «addestra» per prudenza.
# ----------------------------------------------------------------------
AI_KEY_OVH=
AI_URL_OVH_QWEN=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
AI_MODELLO_OVH_QWEN=qwen3.8-27b
AI_TIPI_OVH_QWEN=chat,testo,giudizio,traduzione
AI_FASCIA_OVH_QWEN=media
AI_LIMITI_OVH_QWEN=rpm=2
AI_ADDESTRA_OVH_QWEN=si
AI_PAGAMENTO_OVH_QWEN=no
AI_COSTO_OVH_QWEN=0

# ======================================================================
# Pollinations  [ACCESO di default]
# Limiti: Chiave sk_ dal sito; a crediti («pollen»), 402 a budget esaurito; i limiti veri non sono nella pagina.
# Carta: no · Italia: si · Addestra: si · Fonte: https://github.com/pollinations/pollinations/blob/main/APIDOCS.md
# Termini/privacy: https://pollinations.ai/
# Nota: Serve per le immagini (unico gratuito del giro). I nomi dei modelli si leggono da GET /v1/models. Privacy non letta: segnato «addestra».
# ----------------------------------------------------------------------
AI_KEY_POLLINATIONS=
AI_URL_POLLINATIONS_IMG=https://gen.pollinations.ai/v1
AI_MODELLO_POLLINATIONS_IMG=openai
AI_MODELLO_IMMAGINI_POLLINATIONS_IMG=flux
AI_TIPI_POLLINATIONS_IMG=chat,testo,immagine
AI_FASCIA_POLLINATIONS_IMG=bassa
AI_LIMITI_POLLINATIONS_IMG=rpm=10
AI_ADDESTRA_POLLINATIONS_IMG=si
AI_PAGAMENTO_POLLINATIONS_IMG=no
AI_COSTO_POLLINATIONS_IMG=0

