# Termini/privacy: https://inference-docs.cerebras.ai/support/rate-limits
# Nota: Non ricorrente: non nell'elenco di default. Politica sui dati non letta (messo «no» da verificare).
# ----------------------------------------------------------------------
AI_KEY_CEREBRAS=
AI_URL_CEREBRAS_OSS120=https://api.cerebras.ai/v1
AI_MODELLO_CEREBRAS_OSS120=gpt-oss-120b
AI_TIPI_CEREBRAS_OSS120=chat,testo,giudizio,traduzione,codice
AI_FASCIA_CEREBRAS_OSS120=alta
AI_LIMITI_CEREBRAS_OSS120=rpm=5,tpm=30000,tpg=1000000
AI_ADDESTRA_CEREBRAS_OSS120=no
