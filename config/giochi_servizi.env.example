# config/giochi_servizi.env.example (D70, #131)
# Servizi utili ai giochi più diffusi e ai tripla A 2020-2027: statistiche, profili, partite, classifiche,
# giochi gratis, notizie e patch, stato dei server. Copia in config/giochi_servizi.env (mai nel repository)
# e incolla SOLO le chiavi dopo «=KEY». Un servizio con chiave si accende solo quando la chiave c'è.
# Interruttore: GIOCHI_<SERVIZIO>_ATTIVO=si|no. Base: si per chi non vuole approvazione; no per chi la richiede (Riot, Hypixel, PoE).
# Il filtro NSFW resta sempre attivo fuori dai canali NSFW (D70).
# Controllo dei dati: 09/11/2026. «Stato: non verificato» = dato da conoscenza generale, non dalla pagina ufficiale:
# la sentinella-aggiornamenti lo ricontrolla. Servizi di terzi = non ufficiali, nessuna garanzia.

# ======================================================================
# Riot Games API (LoL, Valorant, TFT, Legends of Runeterra)  [GIOCHI_RIOT_ATTIVO=no di base]
# Giochi: League of Legends, Valorant, TFT, Legends of Runeterra
# URL: https://{regione}.api.riotgames.com (es. europe, euw1)
# Endpoint: account-v1, summoner-v4, match-v5, league-v4, val-match-v1, tft-*, status
# Chiave: si · Approvazione: SI: chiave di produzione (serve un prototipo funzionante; revisione di Developer Relations). Chiave di sviluppo: scade ogni 24 ore, non per prodotti pubblici. Chiave personale: non per uso pubblico (bot aperto = produzione)
# Limiti: Produzione di partenza: 500 richieste/10 s e 30.000/10 min per regione. Personale: 20/s e 100/2 min
# Termini: Ogni progetto va registrato e approvato
# Stato: verificato 09/11/2026 su pagina ufficiale
# Fonte: https://developer.riotgames.com/docs/portal
# ----------------------------------------------------------------------
GIOCHI_RIOT_ATTIVO=no
GIOCHI_RIOT_KEY=

# ======================================================================
# Steam Web API  [GIOCHI_STEAM_ATTIVO=si di base]
# Giochi: CS2, Dota 2, PUBG, Apex, Rust, R6 (profilo, ore, achievement), Helldivers 2, Marvel Rivals, Deadlock, Warframe, Elden Ring… su Steam
# URL: https://api.steampowered.com
# Endpoint: ISteamUser/GetPlayerSummaries, IPlayerService/GetOwnedGames, ISteamUserStats/GetUserStatsForGame, ISteamNews/GetNewsForApp
# Chiave: si (steamcommunity.com/dev/apikey) · Approvazione: no
# Limiti: limite non scritto nella pagina letta (circa 100.000 chiamate al giorno: non verificato)
# Termini: Steam API Terms of Use da accettare (steamcommunity.com/dev/apiterms; testo non letto)
# Stato: parziale 09/11/2026 (pagina ufficiale letta solo in parte)
# Fonte: https://steamcommunity.com/dev
# ----------------------------------------------------------------------
GIOCHI_STEAM_ATTIVO=si
GIOCHI_STEAM_KEY=

# ======================================================================
# Notizie e patch Steam (ISteamNews e feed RSS)  [GIOCHI_STEAMNEWS_ATTIVO=si di base]
# Giochi: tutti i giochi Steam
# URL: https://api.steampowered.com/ISteamNews/GetNewsForApp/v2/?appid={id}&count=5 · RSS https://store.steampowered.com/feeds/news/app/{id}
# Endpoint: notizie e patch di ogni gioco su Steam
# Chiave: no per GetNewsForApp · Approvazione: no
# Limiti: non verificato
# Termini: non letti
# Stato: non verificato: dati da conoscenza generale o fonti non ufficiali, pagina ufficiale non letta il 09/11/2026; da ricontrollare
# Fonte: https://partner.steamgames.com/doc/webapi/ISteamNews
# ----------------------------------------------------------------------
GIOCHI_STEAMNEWS_ATTIVO=si
GIOCHI_STEAMNEWS_KEY=

# ======================================================================
# osu! API v2  [GIOCHI_OSU_ATTIVO=si di base]
# Giochi: osu!
# URL: https://osu.ppy.sh/api/v2
# Endpoint: OAuth: POST /oauth/token (client_credentials, scope public); poi GET /users/{id}/{mode}, /users/{id}/scores/best, /beatmaps/{id}, /rankings/{mode}/performance
# Chiave: si (client id + secret creati nell'account osu!; chiave dell'owner, D70) · Approvazione: no
# Limiti: Massimo 60 richieste al minuto; oltre: token revocato
# Termini: Uso responsabile, cache; vietato sondare ogni minuto per utente, raccogliere dati in massa (usare data.ppy.sh), usare l'API per vantaggi in gioco
# Stato: verificato 09/11/2026 su pagina ufficiale
# Fonte: https://osu.ppy.sh/docs/index.html
# ----------------------------------------------------------------------
GIOCHI_OSU_ATTIVO=si
GIOCHI_OSU_KEY=

# ======================================================================
# GamerPower (giochi e loot gratis)  [GIOCHI_GAMERPOWER_ATTIVO=si di base]
# Giochi: Giochi gratis della settimana (Epic, Steam, GOG, itch, console)
# URL: https://www.gamerpower.com/api
# Endpoint: GET /giveaways?platform=&type=game · /giveaway?id= · /filter?platform=a+b&type=game · /worth
# Chiave: no · Approvazione: no
# Limiti: Massimo 10 richieste al secondo
# Termini: Gratuita anche per uso commerciale. OBBLIGO: credito a GamerPower.com con link attivo; vietato spacciare i dati per propri o venderli
# Stato: verificato 09/11/2026 su pagina ufficiale
# Fonte: https://www.gamerpower.com/api-read
# ----------------------------------------------------------------------
GIOCHI_GAMERPOWER_ATTIVO=si
GIOCHI_GAMERPOWER_KEY=

