# ============================================================
# YOKAI BOT — Template variabili d'ambiente
# ============================================================
# Copia questo file in ".env" e riempi i valori veri.
# Il file ".env" non deve MAI essere committato su GitHub
# (è già escluso in .gitignore).
#
#   cp .env.example .env
# ============================================================

# --- Discord: token dei bot ---------------------------------
# iYokai Main: il bot principale (moderation, security, ticket, ecc.)
YOKAI_BOT_TOKEN=

# iYokai Creator: crea e cede i server di backup (vedi core/backup)
YOKAI_CREATOR_TOKEN=

# iYokai Music: 5 istanze separate, una connessione vocale ciascuna
MUSIC_TOKEN_1=
MUSIC_TOKEN_2=
MUSIC_TOKEN_3=
MUSIC_TOKEN_4=
MUSIC_TOKEN_5=

# iYokai NSFW: applicazione separata per il modulo R34/NSFW
NSFW_TOKEN=

# --- Discord: ID di controllo --------------------------------
# Il tuo user ID Discord — unico account che può usare i comandi owner
OWNER_ID=

# ID del server principale del bot (dove arrivano le richieste
# di custom command, i log globali, ecc.)
MAIN_GUILD_ID=

# --- Database --------------------------------------------------
# Formato: postgresql://utente:password@host:porta/nome_db
DATABASE_URL=postgresql://iyokai:CAMBIAMI@localhost:5432/iyokai_bot

# Dimensione del connection pool (vedi core/database.py)
DB_POOL_MIN=5
DB_POOL_MAX=10

# --- Ambiente ---------------------------------------------------
# "development" oppure "production"
# In development i log sono più verbosi e alcuni controlli sono
# meno rigidi (utile per testare in un server tuo privato)
ENVIRONMENT=development

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Lavalink (music) --------------------------------------------
# Usati SOLO se LAVALINK_NODES sotto è vuoto (comportamento originale
# a singolo nodo — utile se preferisci self-hostare Lavalink).
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CAMBIAMI

# Nodi Lavalink PUBBLICI gratuiti in fallback, se preferito al
# self-hosting (decisione raccomandata per una VM con risorse
# limitate — un nodo Lavalink self-hostato è un processo Java a
# parte, che pesa centinaia di MB extra sulla stessa macchina).
# Formato: "uri1|password1,uri2|password2,..." — controlla che i
# nodi che scegli siano ancora attivi prima di usarli, un elenco
# aggiornato si trova su https://lavalink.darrennathanael.com/.
# Lascia vuoto per usare invece i tre campi LAVALINK_HOST/PORT/
# PASSWORD sopra (singolo nodo).
LAVALINK_NODES=

# --- Memory Guard -------------------------------------------------
# Soglia (in MB di RAM usata dal processo) oltre la quale il Memory
# Guard forza un garbage collection e, se il consumo resta alto,
# avvisa il proprietario in DM (con un cooldown di 30 minuti tra un
# avviso e l'altro). Facoltativa: default 512.
MEMORY_ALERT_THRESHOLD_MB=512

# --- Web Panel (quando sarà pronto) ------------------------------
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=
WEB_PANEL_SECRET_KEY=
