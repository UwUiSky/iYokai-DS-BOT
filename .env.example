# ============================================================
# YOKAI BOT — Template variabili d'ambiente
# ============================================================
# Copia questo file in ".env" e riempi i valori veri.
# Il file ".env" non deve MAI essere committato su GitHub
# (è già escluso in .gitignore).
#
#   cp .env.example .env
# ============================================================

# --- Discord: token dei bot ---------------------------------
# iYokai Main: il bot principale (moderation, security, ticket, ecc.)
YOKAI_BOT_TOKEN=

# iYokai Creator: crea e cede i server di backup (vedi core/backup)
YOKAI_CREATOR_TOKEN=

# iYokai Music: 5 istanze separate, una connessione vocale ciascuna
MUSIC_TOKEN_1=
MUSIC_TOKEN_2=
MUSIC_TOKEN_3=
MUSIC_TOKEN_4=
MUSIC_TOKEN_5=

# iYokai NSFW: applicazione separata per il modulo R34/NSFW
NSFW_TOKEN=

# --- Discord: ID di controllo --------------------------------
# Il tuo user ID Discord — unico account che può usare i comandi owner
OWNER_ID=

# ID del server principale del bot (dove arrivano le richieste
# di custom command, i log globali, ecc.)
MAIN_GUILD_ID=

# --- Database --------------------------------------------------
# Formato: postgresql://utente:password@host:porta/nome_db
DATABASE_URL=postgresql://iyokai:CAMBIAMI@localhost:5432/iyokai_bot

# Dimensione del connection pool (vedi core/database.py)
DB_POOL_MIN=5
DB_POOL_MAX=10

# --- Ambiente ---------------------------------------------------
# OBBLIGATORIA: "development" oppure "production" (maiuscole e spazi non
# contano). Con qualunque altro valore, o senza, il bot non parte.
# In development i log sono più verbosi e alcuni controlli sono
# meno rigidi (utile per testare in un server tuo privato)
ENVIRONMENT=development

# Livello di log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Lavalink (music) --------------------------------------------
# Nodo locale/self-hostato (opzionale) — provato per ULTIMO, dopo i
# nodi pubblici gratuiti già inclusi di default nel codice
# (core/music_logic.py, DEFAULT_PUBLIC_LAVALINK_NODES — verificati
# con una ricerca a settembre 2026, riverificare periodicamente che
# siano ancora attivi). Lascia questi valori di default finché non
# avvii un tuo nodo Lavalink locale, poi aggiornali qui.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=CAMBIAMI

# Nodi EXTRA da aggiungere alla cascata (facoltativo), tra i nodi
# pubblici di default e il tuo nodo locale. Formato:
# "uri1|password1,uri2|password2,...". Lascia vuoto se i nodi
# pubblici già inclusi bastano.
LAVALINK_NODES=

# --- Twitch (alert live/offline) ----------------------------------
# Opzionali: il watcher resta inattivo finché non sono compilati,
# non impedisce l'avvio del bot. Registra un'app su
# https://dev.twitch.tv/console per ottenerli (gratuito).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube Data API (alert live) ---------------------------------
# Opzionale: il watcher resta inattivo finché non è compilata, non
# impedisce l'avvio del bot. Crea una API key sulla Google Cloud
# Console (gratuito). Consuma quota (100 unità per canale per ogni
# controllo, su 10.000/giorno gratuite) — monitora la tua quota se
# sottoscrivi più di un canale.
YOUTUBE_API_KEY=

# --- Pixabay (/fun search-image, ricerca immagini SFW) -------------
# Opzionale ma necessaria per usare il comando: senza questa chiave
# /fun search-image risponde spiegando come attivarla, non impedisce
# l'avvio del bot. Crea una chiave gratuita su
# https://pixabay.com/api/docs/.
PIXABAY_API_KEY=

# --- Radio condivisa 24/7 (/nonstop-main) --------------------------
# Cartella per i tuoi inediti (canzoni di cui detieni i diritti, non
# ancora pubblicate). Letta SOLO dal nodo Lavalink locale (i nodi
# pubblici non hanno accesso al filesystem di questa macchina) - devi
# avere un nodo Lavalink locale attivo perché gli inediti funzionino.
# Vuota di default: gli inediti restano semplicemente non disponibili.
MAIN_RADIO_LOCAL_FOLDER=

# --- Memory Guard -------------------------------------------------
# Soglia (in MB di RAM usata dal processo) oltre la quale il Memory
# Guard forza un garbage collection e, se il consumo resta alto,
# avvisa il proprietario in DM (con un cooldown di 30 minuti tra un
# avviso e l'altro). Facoltativa: default 512.
MEMORY_ALERT_THRESHOLD_MB=512

# --- Server web (SEC-14) ------------------------------------------
# Indirizzo su cui ascoltano TUTTI i piccoli server web del bot
# (callback OAuth2 del restore, webhook custom in ricezione — sotto).
# Default "127.0.0.1": solo questa macchina, non tutta la rete. Per
# esporli davvero, metti un reverse proxy con HTTPS davanti a questo
# indirizzo/porta — non cambiare questo valore in "0.0.0.0", che li
# espone in HTTP semplice, senza cifratura, a chiunque raggiunga la
# macchina.
WEB_BIND_HOST=127.0.0.1

# --- Web Panel (quando sarà pronto) ------------------------------
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=
WEB_PANEL_SECRET_KEY=

# --- Restore utenti via OAuth2 (SPEC.md §11.11) ------------------
# OAUTH2_CLIENT_ID/SECRET/REDIRECT_URI (sopra) sono RIUSATI anche qui
# — stesso client OAuth2 dell'applicazione Discord, scope aggiuntivo
# "guilds.join". OAUTH_ENCRYPTION_KEY cifra i token salvati (AES-256-
# GCM): generala una volta con
#   python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# e non cambiarla più senza prima ricifrare i token esistenti. Senza
# questa chiave (e senza OAUTH2_CLIENT_ID/SECRET/REDIRECT_URI) il
# server di questa callback non parte affatto (log WARNING all'avvio).
OAUTH_ENCRYPTION_KEY=
# Porta su cui ascolta il piccolo server web che riceve la callback
# OAuth2 di Discord dopo l'autorizzazione di un utente (indirizzo:
# WEB_BIND_HOST sopra). OAUTH2_REDIRECT_URI deve puntare a questo
# indirizzo + /oauth/callback.
RESTORE_WEB_PORT=8420

# --- Webhook custom in ricezione (SPEC.md §10.8) -----------------
# Porta su cui ascolta il server che riceve i webhook PUSH di servizi
# terzi (/alerts webhook-create, indirizzo: WEB_BIND_HOST sopra) —
# parte solo se esiste già almeno un webhook configurato (se il primo
# viene creato dopo l'avvio del bot, serve un riavvio perché il
# server parta). ALERTS_WEBHOOK_PUBLIC_BASE_URL è il dominio/reverse
# proxy che punta a questa porta (es. "https://webhooks.miobot.tld")
# — finché resta vuoto, /alerts webhook-create mostra solo il token,
# senza un URL completo.
ALERTS_WEBHOOK_PORT=8421
ALERTS_WEBHOOK_PUBLIC_BASE_URL=

# --- Premium (SPEC.md §3, decisione #41) --------------------------
# Override temporaneo di fase ALPHA: quando true, TUTTE le feature
# premium sono sbloccate per TUTTI i server, a prescindere da
# whitelist/boost/abbonamento. Lascia vuoto per il default automatico
# (spento se ENVIRONMENT=production, acceso in development — se resta acceso
# in produzione, il log all'avvio lo segnala con un WARNING), oppure
# imposta true/false per forzarlo esplicitamente. Metti a false quando
# l'alpha finisce.
PREMIUM_ALPHA_UNLOCK_ALL=

# --- Sicurezza (SEC-13, decisione owner D7) -----------------------
# /owner eval, /owner shell e /owner cog-load eseguono codice
# arbitrario sulla macchina che ospita il bot. Lascia vuoto per il
# default automatico (spento se ENVIRONMENT=production, acceso in
# development), o imposta true/false per forzarlo esplicitamente. Se è
# acceso, il log all'avvio lo segnala con un WARNING.
ENABLE_EVAL=
